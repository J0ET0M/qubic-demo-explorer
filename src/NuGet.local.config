<?xml version="1.0" encoding="utf-8"?>
<!--
  Maintainer NuGet config. Enabled by passing USE_LOCAL_PACKAGES=true to
  docker build (or the compose env). Adds ./local-packages/ as a source so
  pre-release .nupkg files can be referenced. Falls through to nuget.org
  for everything else.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local-packages" value="./local-packages" />
  </packageSources>
</configuration>
