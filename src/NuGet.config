<?xml version="1.0" encoding="utf-8"?>
<!--
  Default NuGet config used by every build. Public feed only, so anyone
  cloning the repo can build with just `docker build`.

  Maintainers working against pre-release Qubic.* packages should drop the
  .nupkg files into ./local-packages/ and pass `USE_LOCAL_PACKAGES=true` to
  docker build (or the compose env) to swap this file for NuGet.local.config.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
