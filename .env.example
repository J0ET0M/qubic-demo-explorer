# Copy this file to `.env` and adjust as needed.
# docker compose automatically reads .env from the same directory.

# ─── Bob node ─────────────────────────────────────────────────────────────
# The Qubic Bob HTTP endpoint used by indexer, analytics, and api.
# All three services read this same URL, so change once here.
BOB_URL=https://bobnet.qubic.li

# ─── NuGet package source ─────────────────────────────────────────────────
# Set to true if you're building against pre-release Qubic.* packages you've
# dropped into src/local-packages/ (maintainer flow). See README for details.
USE_LOCAL_PACKAGES=false
