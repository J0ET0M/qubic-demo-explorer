# Copy this file to `.env` and adjust as needed.
# docker compose automatically reads .env from the same directory.
# Every key below has a sensible default baked into docker-compose.yml —
# entries left blank fall back to that default.

# ─── Bob node ─────────────────────────────────────────────────────────────
# Qubic Bob HTTP endpoint shared by indexer, analytics, and api.
BOB_URL=https://bobnet.qubic.li

# ─── ClickHouse credentials ───────────────────────────────────────────────
# Applied to both the clickhouse container itself AND every consumer
# (indexer, analytics, api, pruner) so they authenticate correctly.
# Leave PASSWORD blank on a fresh setup; set it before exposing anywhere.
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# ─── Admin API ────────────────────────────────────────────────────────────
# Required to hit /api/admin/* endpoints (owner backfill, network-stats
# snapshots, etc.). Send it as `X-Api-Key: <value>` in requests. If left
# blank the admin routes return 503 "Admin API is not configured".
ADMIN_API_KEY=

# ─── Seq structured logging (optional) ────────────────────────────────────
# Leave blank to disable Seq — the services silently skip it if unset.
SEQ_URL=
SEQ_API_KEY=

# ─── Indexer bootstrap ────────────────────────────────────────────────────
# On a fresh DB, start from a specific tick, or from the current chain head.
# StartFromLatest=true wins if StartTick > 0 is also set; use one or the other.
# After the first run these settings are ignored — the indexer resumes from
# its own high-water mark stored in ClickHouse.
INDEXER_START_TICK=0
INDEXER_START_FROM_LATEST=false

# ─── Pruner ───────────────────────────────────────────────────────────────
# Set to `false` to actually drop old data. Leave `true` while testing so the
# pruner logs what it *would* delete without touching anything.
PRUNER_DRY_RUN=true

# ─── Build-time only ──────────────────────────────────────────────────────
# Read by docker build (not by the running containers). Set to `true` when
# building against pre-release Qubic.* packages placed in src/local-packages/.
USE_LOCAL_PACKAGES=false
